# ---------------------------------------------------------------------------
# SensyGent — optional configuration
# ---------------------------------------------------------------------------
# Copy this file to `.streamlit/secrets.toml` and fill in whatever you like.
# EVERYTHING HERE IS OPTIONAL. With no secrets at all, SensyGent still works:
# the built-in LocalCare engine answers and the voice uses keyless edge-tts.
#
# On Streamlit Community Cloud: Dashboard → your app → Settings → Secrets,
# then paste the same keys there.
# ---------------------------------------------------------------------------

# --- A free LLM brain (pick one) -------------------------------------------
# Groq — free tier, extremely fast, best default:   https://console.groq.com/keys
GROQ_API_KEY = "gsk_..."

# Google AI Studio (Gemini) — free daily quota:      https://aistudio.google.com/apikey
# GEMINI_API_KEY = "AIza..."

# OpenRouter — models ending in ":free" cost nothing: https://openrouter.ai/keys
# OPENROUTER_API_KEY = "sk-or-v1-..."

# DeepSeek — inexpensive, free credit on signup:
# DEEPSEEK_API_KEY = "sk-..."

# --- Optional preferences ---------------------------------------------------
# provider  = "groq"                 # pin a provider instead of auto-detecting
# model     = "llama-3.3-70b-versatile"
# companion_name = "Momo"            # what you'd like to call your companion
# SENSYGENT_DB = "data/sensygent.db" # where your private data file lives

# --- Local models (no key, nothing leaves your machine) ---------------------
# Install Ollama (https://ollama.com), run `ollama pull llama3.2`, then set:
# provider = "ollama"
# ollama_url = "http://localhost:11434/v1/chat/completions"
